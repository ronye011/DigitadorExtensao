{
  "manifest_version": 3,
  "name": "AD Block",
  "version": "1.0",
  "description": "Bloqueador de anuncios",

  "icons": {
    "16": "./icons/Adblock16.png",
    "48": "./icons/Adblock48.png",
    "128": "./icons/Adblock128.png"
  },
  
  "permissions": [
    "storage"
  ],

  "action": {
    "default_popup": "popup.html",
    "default_title": "Configurar mensagem"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}